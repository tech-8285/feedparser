<!--
Description:  switching the default namespace to an extension namespace is scoped to the declaring element
Expect:       not bozo and entries[0]['media_content'][0]['url'] == 'http://example.com/a.mp3' and 'content' not in entries[0] and entries[1]['content'][0]['value'] == 'plain'
-->
<rss version="2.0">
<channel>
<title>test</title>
<link>http://example.com/</link>
<item>
  <title>i1</title>
  <content xmlns="http://search.yahoo.com/mrss/" url="http://example.com/a.mp3" type="audio/mpeg"/>
</item>
<item>
  <title>i2</title>
  <content>plain</content>
</item>
</channel>
</rss>
