<!--
Description:  a locally declared unknown namespace must not affect subsequent known fields
Expect:       not bozo and entries[0]['unknown_element'] == 'x' and entries[0]['author'] == 'alice' and entries[0]['media_content'][0]['url'] == 'http://example.com/a.mp3' and entries[1]['author'] == 'carol'
-->
<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:dc="http://purl.org/dc/elements/1.1/">
<channel>
<title>test</title>
<link>http://example.com/</link>
<item xmlns:unknown="http://unknown.example/ns">
  <title>i1</title>
  <unknown:element>x</unknown:element>
  <dc:creator>alice</dc:creator>
  <media:content url="http://example.com/a.mp3" type="audio/mpeg"/>
</item>
<item>
  <title>i2</title>
  <dc:creator>carol</dc:creator>
</item>
</channel>
</rss>
